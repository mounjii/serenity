generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// PENDING = waiting for the customer to confirm on WhatsApp; it holds the slot until confirmationExpiresAt.
enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingSource {
  ONLINE
  ADMIN
}

enum NotificationRecipient {
  CUSTOMER
  OWNER
}

enum NotificationStatus {
  SENT
  FAILED
}

enum VoucherKind {
  REWARD
  BIRTHDAY
  PERSONALIZED
  PROMO
}

enum LoyaltyAlertKind {
  POINTS
  TIER
  BIRTHDAY
  PERSONALIZED
  PROMO
  VOUCHER
}

model Service {
  id              String    @id @default(cuid())
  slug            String    @unique @db.VarChar(80)
  name            String    @db.VarChar(120)
  description     String          @db.Text
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  options         ServiceOption[]
  bookings        Booking[]

  @@map("services")
}

/// One bookable duration of a service, with its own price (e.g. Swedish Massage 90 min = 500 MAD).
model ServiceOption {
  id              String   @id @default(cuid())
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([serviceId, durationMinutes])
  @@map("service_options")
}

model Therapist {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(120)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@map("therapists")
}

/// weekday: 0 = Sunday ... 6 = Saturday. Minutes are counted from local midnight (Africa/Casablanca).
model OpeningHours {
  id          Int     @id @default(autoincrement())
  weekday     Int     @unique
  openMinute  Int
  closeMinute Int
  closed      Boolean @default(false)

  @@map("opening_hours")
}

/// date is a local calendar day (Africa/Casablanca), stored as a DATE.
model ClosedDay {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  reason    String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  @@map("closed_days")
}

/// All DateTime columns are stored in UTC.
model Booking {
  id              String            @id @default(cuid())
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  therapistId     String
  therapist       Therapist         @relation(fields: [therapistId], references: [id])
  startAt         DateTime
  endAt           DateTime
  blockedUntil    DateTime
  durationMinutes Int
  priceCents      Int
  customerName    String            @db.VarChar(80)
  customerPhone   String            @db.VarChar(20)
  note            String?           @db.VarChar(500)
  /// Language the client booked in (en, fr, ar); their WhatsApp messages use it.
  locale          String            @default("en") @db.VarChar(5)
  status          BookingStatus     @default(PENDING)
  source          BookingSource     @default(ONLINE)
  idempotencyKey  String?           @unique @db.VarChar(100)
  confirmationExpiresAt DateTime?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  /// Who cancelled: CUSTOMER (WhatsApp reply), ADMIN, or EXPIRED (no reply in time).
  cancelReason    String?           @db.VarChar(20)
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  discountCents   Int               @default(0)
  voucherId       String?           @unique
  voucher         Voucher?          @relation(fields: [voucherId], references: [id])
  notifications   NotificationLog[]
  loyaltyLedgers  LoyaltyLedger[]

  @@index([therapistId, startAt])
  @@index([status, startAt])
  @@index([updatedAt])
  @@index([status, confirmationExpiresAt])
  @@map("bookings")
}

/// Customer account, keyed by the WhatsApp / booking phone number (E.164).
model Customer {
  id           String          @id @default(cuid())
  name         String          @db.VarChar(80)
  phone        String          @unique @db.VarChar(20)
  passwordHash String          @db.VarChar(100)
  birthday     DateTime?       @db.Date
  points       Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  ledgers      LoyaltyLedger[]
  vouchers     Voucher[]
  alerts       LoyaltyAlert[]

  @@map("customers")
}

model LoyaltyLedger {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  points     Int
  reason     String   @db.VarChar(40)
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([bookingId])
  @@map("loyalty_ledgers")
}

model Voucher {
  id              String      @id @default(cuid())
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind            VoucherKind
  code            String      @unique @db.VarChar(16)
  title           String      @db.VarChar(120)
  discountCents   Int?
  discountPercent Int?
  serviceId       String?
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime    @default(now())
  booking         Booking?

  @@index([customerId, usedAt])
  @@map("vouchers")
}

model LoyaltyAlert {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       LoyaltyAlertKind
  payload    Json
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([customerId, createdAt])
  @@map("loyalty_alerts")
}

/// Single salon-owner login. Env ADMIN_* is used until this row is saved from the dashboard.
model AdminAccount {
  id           Int      @id @default(1)
  username     String   @unique @db.VarChar(40)
  passwordHash String   @db.VarChar(100)
  updatedAt    DateTime @updatedAt

  @@map("admin_accounts")
}

model NotificationLog {
  id        String                @id @default(cuid())
  bookingId String
  booking   Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recipient NotificationRecipient
  phone     String                @db.VarChar(20)
  template  String                @db.VarChar(60)
  payload   Json
  provider  String                @db.VarChar(30)
  status    NotificationStatus
  error     String?               @db.Text
  createdAt DateTime              @default(now())

  @@index([createdAt])
  @@map("notification_logs")
}
