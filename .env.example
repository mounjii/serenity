# Copy to .env and fill in. Never commit .env.

# MySQL connection used by the app and by Prisma migrations.
# Password characters such as @ : / # % must be URL-encoded (e.g. @ -> %40).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Development only: an empty database Prisma can use as a scratch copy for `prisma migrate dev`.
# Not needed in production (production uses `prisma migrate deploy`).
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_shadow"

# Optional: size of the MySQL connection pool (default 5).
DATABASE_CONNECTION_LIMIT=5

# Admin account (single admin). Generate the hash with: npm run hash-password -- "your password"
# In this file every "$" of the hash must be written "\$". In the Hostinger panel paste the raw hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Random string of at least 32 characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# WhatsApp notifications:
#   "manual" - free: nothing is sent automatically; the client and the admin use buttons that open
#              their own WhatsApp with the message already written. Online bookings stay "Waiting"
#              (time slot reserved) until the admin confirms or cancels them; they never expire.
#   "mock"   - printed and stored, never sent; the admin can simulate the client's Confirm/Cancel reply.
#   "meta"   - automatic messages through the official WhatsApp Business Cloud API (paid per message).
WHATSAPP_PROVIDER=mock
# Salon owner's WhatsApp number in E.164 format (example value below).
OWNER_WHATSAPP_PHONE=+212612345678
# "Contact Us" section on the home page. The phone defaults to OWNER_WHATSAPP_PHONE;
# the address (with its map) and the email are shown only when filled in.
CONTACT_PHONE=
CONTACT_ADDRESS=
CONTACT_EMAIL=
# Meta WhatsApp Cloud API (server-side only). Leave empty while using the mock.
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# App secret used to verify the X-Hub-Signature-256 header of webhook calls.
META_WA_APP_SECRET=
# Any random string; enter the same value as "Verify token" when registering
# https://<your-domain>/api/whatsapp/webhook in the Meta app dashboard.
META_WA_VERIFY_TOKEN=
META_WA_API_VERSION=v21.0
# Language code of the approved templates.
META_WA_TEMPLATE_LANG=en
